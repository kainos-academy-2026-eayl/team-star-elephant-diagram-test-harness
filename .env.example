# Copy to .env (git-ignored) and fill in. Every value is optional except E2E_ADMIN_PASSWORD for the admin tests.

# Frontend and backend addresses. Use localhost, not 0.0.0.0: login cookies are Secure, which browsers only
# accept over plain HTTP on localhost.
BASE_URL=http://localhost:3000
API_URL=http://localhost:3001

# Password of the seeded staff accounts (the ADMIN_SEED_PASSWORD used when seeding the backend).
# Admin tests are skipped when this is empty.
E2E_ADMIN_PASSWORD=

# Override which seeded staff account is used for each role (defaults come from the backend's prisma/adminUsers.ts).
# E2E_SUPER_ADMIN_EMAIL=charlotte.bennett@example.com
# E2E_ADMIN_EMAIL=amelia.clarke@example.com
# E2E_INVENTORY_MANAGER_EMAIL=sophie.davies@example.com
# E2E_FINANCE_MANAGER_EMAIL=emily.thompson@example.com
# E2E_CUSTOMER_SERVICE_EMAIL=isla.stewart@example.com
